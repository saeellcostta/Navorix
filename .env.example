# =============================================
# Navorix Exchange — Environment Variables
# Copy this file to .env.local and fill in real values
# =============================================

# ────────────────────────────────────────────
#  SOLANA
# ────────────────────────────────────────────
# Options: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Custom Helius or QuickNode RPC (faster + no rate limits)
# Leave empty to use the public Solana RPC (slow, rate-limited)
NEXT_PUBLIC_SOLANA_RPC_URL=

# Navorix fee collector wallet — ALL fees go here
NEXT_PUBLIC_FEE_WALLET=FvmN4BnLKR25QWXXoLof2RZFzwC8XU3QLcPr1aJg1UvQ

# ────────────────────────────────────────────
#  SITE
# ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ────────────────────────────────────────────
#  SUPABASE
#  1. Create a project at https://supabase.com
#  2. Go to Settings > API
#  3. Copy Project URL and anon key below
#  4. Go to Settings > API > Service role key (keep SECRET)
# ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — NEVER expose in the browser
# Used only in API routes (src/lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ────────────────────────────────────────────
#  STORAGE (for token images)
#  Create a public bucket called "token-images" in Supabase Storage
# ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=token-images

# ────────────────────────────────────────────
#  AUTH (optional — for future user sessions)
# ────────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
